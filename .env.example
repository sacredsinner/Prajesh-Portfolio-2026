# Copy to .env.local for local development and fill in real values.
# In production these live in the Vercel project settings. Never commit real values.

# Neon Postgres (set automatically by the Vercel Neon integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (public store) for images, client logos and the showcase video
BLOB_READ_WRITE_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://shakyaprajesh.com.np
# Set to "true" only while creating a new admin account, then remove it.
ALLOW_ADMIN_SIGNUP=

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend: password resets, contact-form notifications and replies from /admin
RESEND_API_KEY=
# An address on a domain verified in Resend, e.g. "Prajesh Shakya <hello@shakyaprajesh.com.np>"
RESEND_FROM_EMAIL=
# Where new enquiries are sent (defaults to the admin email in lib/auth.ts)
CONTACT_NOTIFICATION_EMAIL=

# Canonical site address used for SEO (defaults to https://www.shakyaprajesh.com.np)
NEXT_PUBLIC_SITE_URL=

# Notion API (Sync notes / blog posts from a Notion database)
# Create an integration at https://www.notion.so/profile/integrations
NOTION_API_KEY=
# The 32-character ID from your Notion database URL
NOTION_DATABASE_ID=
# Optional: Bearer token or query param secret to protect the /api/notion/sync webhook
NOTION_SYNC_SECRET=

# AI Brand Strategist ("Praj" - Chat Assistant)
# Get a free key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

